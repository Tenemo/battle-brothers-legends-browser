{
  "name": "battle-brothers-legends-browser",
  "private": true,
  "version": "2.5.0",
  "description": "Battle Brothers Legends build planner for perks, backgrounds, and shareable builds.",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "prepare": "husky",
    "prepare:assets": "node ./scripts/ensure-legends-reference.ts && pnpm run generate:build-seo-data && pnpm run generate:social-image",
    "generate:build-seo-data": "node ./scripts/generate-build-share-seo-data.ts",
    "generate:social-image": "node ./scripts/generate-root-social-image.ts",
    "predev": "pnpm run generate:build-seo-data && pnpm run generate:social-image",
    "dev": "vite",
    "predev:test": "pnpm run generate:build-seo-data && pnpm run generate:social-image",
    "dev:test": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "prebuild": "pnpm run check:knip && pnpm run generate:build-seo-data && pnpm run generate:social-image",
    "prebuild:netlify": "pnpm run check:knip",
    "build": "tsc -b && vite build && node ./scripts/prerender-root.ts",
    "build:netlify": "pnpm run generate:build-seo-data && pnpm run generate:social-image && tsc -b && vite build && node ./scripts/prerender-root.ts && node ./scripts/build-netlify-edge-functions.ts",
    "check:netlify-manifest": "node ./scripts/assert-netlify-edge-manifest.ts",
    "check:ci:non-e2e": "pnpm lint && pnpm stylelint && pnpm typecheck && pnpm test && pnpm netlify:build && pnpm check:netlify-manifest",
    "check:knip": "pnpm run knip && pnpm run knip:production",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "knip": "knip --config knip.config.ts",
    "knip:production": "knip --production --config knip.config.ts",
    "stylelint": "stylelint \"src/**/*.{css,scss}\"",
    "stylelint:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "netlify:build": "netlify build --offline",
    "preview": "vite preview",
    "smoke:deployed-seo": "node ./scripts/smoke-deployed-seo.ts",
    "typecheck": "tsc -b",
    "tsc": "tsc -b",
    "lint": "eslint .",
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "test:e2e:production": "node ./node_modules/@playwright/test/cli.js test --workers=1",
    "ensure:legends-reference": "node ./scripts/ensure-legends-reference.ts",
    "sync:icons": "node ./scripts/sync-legends-icons.ts",
    "sync:perks": "node ./scripts/sync-legends-perks.ts"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-virtuoso": "^4.18.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@netlify/edge-functions": "^3.0.8",
    "@netlify/functions": "^5.3.0",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "knip": "^6.29.0",
    "netlify-cli": "27.0.1",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
